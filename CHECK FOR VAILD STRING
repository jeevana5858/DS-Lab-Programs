#include <stdio.h>
#include <ctype.h>

int isValidString(const char *str) {
    int i = 0;
    while (str[i] != '\0') {
        if (!isalnum(str[i])) {
            return 0; // Invalid if not a letter or digit
        }
        i++;
    }
    return 1; // Valid string
}

int main() {
    char input[100];

    printf("Enter a string: ");
    scanf("%s", input);

    if (isValidString(input)) {
        printf("Valid string!\n");
    } else {
        printf("Invalid string!\n");
    }

    return 0;
}
